# --- Supabase (optional: app works without it, scans just won't be logged) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key. Backend only. Never put it in frontend code or commit it.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=label-images

# --- AI vision reader (optional but recommended: much better on small print, glare and Hindi) ---
# Fill ONE of the two keys. With a key set, scans use "hybrid" mode: AI reads, OCR cross-checks.
# Keys stay on the server. Label photos are sent to the provider you choose.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# anthropic | gemini | leave empty to use whichever key is set (Anthropic first)
VISION_PROVIDER=
# empty = default (claude-sonnet-5-5 for Anthropic, gemini-3.8-flash for Gemini)
VISION_MODEL=
# auto (hybrid if a key is set, else OCR) | hybrid | ai | ocr
READER_MODE=auto
VISION_TIMEOUT_S=45
# low | minimal | medium | high  (Gemini 3.x: lower = faster)
GEMINI_THINKING_LEVEL=low
# false = if the model is retired the app finds a working Gemini flash model by itself
VISION_MODEL_STRICT=false
VISION_MAX_SIDE=1400
# confidence given to a line where AI and OCR read different numbers (0.70 = flagged only;
# set below MIN_FIELD_CONF, e.g. 0.30, to send such fields to "Needs review")
AI_DISAGREEMENT_CONF=0.70

# --- OCR / pipeline ---
# When the AI reader is on, OCR only supplies positions + a second opinion, so it runs lean (no Hindi pass,
# no fallback variant, image scaled to this longest side). 0 = use the full OCR settings below in hybrid mode too.
HYBRID_OCR_MAX_SIDE=1400
OCR_LANGS=en,hi
OCR_GPU=false
# English is always the primary recogniser. Other languages listed above (hi) are read by a
# secondary recogniser on the same boxes and only win where the box contains that script.
OCR_SECONDARY_SCRIPT=true
# try one alternative preprocessing variant when the first OCR pass is weak
OCR_FALLBACK_VARIANTS=true
MIN_TOKEN_CONF=0.10
PREPROCESS=true
PREPROCESS_MAX_SIDE=2560
# off by default: warping to the largest quadrilateral can crop text outside a sticker
PERSPECTIVE_CORRECTION=false
# below these OCR confidences a result becomes REVIEW / LOW_CONFIDENCE
MIN_FIELD_CONF=0.40
MIN_OVERALL_CONF=0.45
# auto category detection is applied only at or above this score
MIN_CATEGORY_CONF=0.6
# Rule 9 contrast proxy (0..1 luminance contrast); below this a declaration is sent to review
MIN_TEXT_CONTRAST=0.25
MAX_UPLOAD_MB=10

# --- CORS (set to your frontend origin in production) ---
CORS_ORIGINS=*
